# ==============================================================================
# Obsidian Knowledge Curator (OKC) — Environment Template
# Copy this file to .env or run: uv run python scripts/setup_project.py
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Workspace & Obsidian Vault Parameters
# ------------------------------------------------------------------------------
# Absolute path to your local Obsidian Vault (DO NOT commit your actual .env)
VAULT_ROOT="/path/to/your/Obsidian/Vault"
OBSIDIAN_VAULT_PATH="/path/to/your/Obsidian/Vault"

# Absolute path to Obsidian CLI binary (e.g. /opt/homebrew/bin/obsidian or /usr/local/bin/obsidian)
OBSIDIAN_CLI_PATH="/opt/homebrew/bin/obsidian"

# ------------------------------------------------------------------------------
# 2. Ingestion & Scoring Limits
# ------------------------------------------------------------------------------
MAX_TRANSCRIPT_CHARS=50000
CONTEXT_DEGRADATION_THRESHOLD=0.40
MIN_TECHNICAL_SCORE=60

# ------------------------------------------------------------------------------
# 3. Logging & Virtualenv Control
# ------------------------------------------------------------------------------
ENV="development" # development | staging | production
LOG_LEVEL="INFO"
UV_PROJECT_ENVIRONMENT="obsidianKnowledgeCurator"

# ------------------------------------------------------------------------------
# 4. LLM Providers & Hybrid Engine Configuration
# ------------------------------------------------------------------------------
# DENSITY_GRADER_PROVIDER: "gemini" (default) or "ollama"
DENSITY_GRADER_PROVIDER="gemini"
GEMINI_API_KEY=""

# Local Ollama fallback configuration
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# ------------------------------------------------------------------------------
# 5. graphify-daemon (live knowledge-graph MCP daemon, ~/projects/graphify-daemon)
# ------------------------------------------------------------------------------
GRAPHIFY_DAEMON_URL="http://127.0.0.1:8787"
GRAPHIFY_DAEMON_API_KEY=""
GRAPHIFY_DAEMON_GRAPH_JSON="/path/to/graphify-daemon/out/graph.json"

# Forces which graph backend knowledge_commands.py/okc_doctor.py use, on top
# of their default automatic daemon-first/legacy-fallback detection:
#   auto (default) -- try the daemon, fall back to legacy silently
#   local          -- never try the daemon, always use the legacy pipeline
#   remote         -- only try the daemon; fail loudly instead of falling back
# GRAPHIFY_BACKEND=auto
