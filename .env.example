# ==============================================================================
# KoreCurator Core Configuration
# ==============================================================================


# Workspace & Vault Parameters
VAULT_ROOT="/Users/YOUR_USER/Documents/Obsidian"
OBSIDIAN_VAULT_PATH="/Users/YOUR_USER/Documents/Obsidian"
OBSIDIAN_CLI_PATH="/opt/homebrew/bin/obsidian"

# Ingestion & Scraping Limits
MAX_TRANSCRIPT_CHARS=50000
CONTEXT_DEGRADATION_THRESHOLD=0.40
MIN_TECHNICAL_SCORE=60


# Logging & Environment Control
ENV="development" # development | staging | production
LOG_LEVEL="INFO"

# LLM Providers & Hybrid Engine Configuration
# DENSITY_GRADER_PROVIDER can be "gemini" (default) or "ollama"
DENSITY_GRADER_PROVIDER="gemini"
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

